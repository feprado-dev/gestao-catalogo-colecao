{
  "rewrites": [
    {
      "source": "/((?!_vercel/).*)",
      "destination": "/index.html"
    }
  ],
  "images": {
    "sizes": [200, 400, 800],
    "qualities": [75],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2592000,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "hqqnnxnbxqfocsmrovmw.supabase.co",
        "pathname": "/storage/v1/object/public/magazine-covers/**"
      }
    ]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-ZGmw+j2Jp6ndiU4vdon73PyPaR2GsGFBsQHjfzXpueM='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://hqqnnxnbxqfocsmrovmw.supabase.co; font-src 'self'; connect-src 'self' https://hqqnnxnbxqfocsmrovmw.supabase.co wss://hqqnnxnbxqfocsmrovmw.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://felipepradowww.vercel.app; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
